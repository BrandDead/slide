{
  "name": "dealt-slide-mvp",
  "private": true,
  "version": "1.0.0",
  "description": "DEALT/SLIDE - Urban Warfare RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd ../backend/python && python app.py",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\" --names \"frontend,backend\" --prefix-colors \"cyan,yellow\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --report-unused-disable-directives",
    "preview": "vite preview",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "assets:process": "node scripts/assets/process.mjs",
    "assets:audit": "node scripts/assets/audit.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run assets:audit"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.0.1",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.13.5",
    "framer-motion": "^10.16.16",
    "lucide-react": "^1.23.0",
    "mapbox-gl": "^3.0.1",
    "phaser": "^3.70.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "socket.io-client": "^4.7.2",
    "uuid": "^9.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "terser": "^5.48.0",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^4.1.10"
  }
}