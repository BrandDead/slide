# Backend API
VITE_API_URL=http://localhost:5000

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox Configuration
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Socket.IO (for multiplayer features)
VITE_SOCKET_URL=ws://localhost:3001

# Environment
VITE_ENV=development

# Birthday demo path — set to '1' to bypass Supabase auth and seed a
# pre-claimed Las Olas block so the full claim → place → earn → combat
# loop is playable without credentials.
# NEVER set this in a production deployment.
# VITE_DEMO_MODE=1
