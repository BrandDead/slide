# Database Configuration
# Use one of these options:

# Option 1: Supabase (Recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Option 2: Local PostgreSQL
DATABASE_URL=postgresql://localhost:5432/slide_dev

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-for-jwt-and-sessions

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Optional: Google Maps (Street View + 3D Tiles)
GOOGLE_MAPS_API_KEY=

# Feature Flags
ENABLE_STREET_VIEW=false
ENABLE_3D_TILES=false
ENABLE_WORLD_TICK=true

# Photo-to-member likeness (GPT Image)
# Unset: roster shows the real photo crop; body stays locked.
# Set OPENAI_API_KEY to enable GTA-style generation. Never commit the key.
# OPENAI_API_KEY=
# Optional pin. Default tries gpt-image-2.5-flare, then gpt-image-2.
# Size 1024x1536, quality medium, images.edit with the upload as identity.
# SLIDE_AVATAR_MODEL=gpt-image-2.5-flare
# pip install 'openai>=1.40.0' is required for the GPT Image path.
# DALL·E is never used. SLIDE_AVATAR_PROVIDER is no longer required.
# See docs/PHOTO_LIKENESS.md.
