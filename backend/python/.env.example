# Database Configuration
# Use one of these options:

# Option 1: Supabase (Recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Option 2: Local PostgreSQL
DATABASE_URL=postgresql://localhost:5432/slide_dev

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-for-jwt-and-sessions

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Optional: Google Maps (Street View + 3D Tiles)
GOOGLE_MAPS_API_KEY=

# Feature Flags
ENABLE_STREET_VIEW=false
ENABLE_3D_TILES=false
ENABLE_WORLD_TICK=true
